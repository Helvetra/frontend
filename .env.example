# Backend API URL (local development)
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Self-hosted Matomo (cookieless, IP-anonymised). Leave both blank to
# disable tracking entirely (e.g. local dev). In prod these point at the
# helvetra Matomo instance.
NUXT_PUBLIC_MATOMO_URL=
NUXT_PUBLIC_MATOMO_SITE_ID=
